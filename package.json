{
  "name": "@runner-corp/dsh-scenario-workspace",
  "version": "1.12.0",
  "description": "场景工作台：动态场景容器 + 显式 Skill 组装器 + MCP 标准场景协同（DSH Web 插件）",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "node scripts/check.mjs",
    "index": "node scripts/build-index.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ElioLin/crm-dsh-plugin.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "index": {
      "titleZh": "场景工作台",
      "titleEn": "CRM Workspace Hub",
      "category": "workflow",
      "keywords": [
        "crm",
        "scenario",
        "skill",
        "mcp"
      ],
      "dshRange": ">=0.2.0"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "react": "^18.0.0"
  }
}
